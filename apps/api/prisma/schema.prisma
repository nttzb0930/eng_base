  image_content_type String?
  source_version     String                            @db.VarChar(64)
  content_sha256     String                            @db.VarChar(64)
  provenance         Json
  license_reference  String
  status             toeic_writing_publication_status  @default(DRAFT)
  published_at       DateTime?                         @db.Timestamp(6)
  created_at         DateTime                          @default(now()) @db.Timestamp(6)
  updated_at         DateTime                          @default(now()) @updatedAt @db.Timestamp(6)
  set                toeic_writing_sets                @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_tasks_set_id_fkey")
  drafts             toeic_writing_drafts[]
  submissions        toeic_writing_submissions[]
  image_contexts     toeic_writing_image_contexts[]
  ai_grades          toeic_writing_ai_grades[]
  assistance_events  toeic_writing_assistance_events[]

  @@unique([source, source_task_id], map: "toeic_writing_tasks_source_task_key")
  @@unique([set_id, part, order_index], map: "toeic_writing_tasks_set_part_order_key")
  @@index([status, part, order_index], map: "toeic_writing_tasks_catalog_idx")
}

model toeic_writing_drafts {
  id              Int                 @id @default(autoincrement())
  user_id         String
  task_id         Int
  response_text   String              @db.Text
  content_version String              @db.VarChar(64)
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  updated_at      DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  users           users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_drafts_user_id_fkey")
  task            toeic_writing_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_drafts_task_id_fkey")

  @@unique([user_id, task_id], map: "toeic_writing_drafts_user_task_key")
}

model toeic_writing_submissions {
  id                 Int                 @id @default(autoincrement())
  user_id            String
  task_id            Int
  submission_key     String              @db.Uuid
  response_text      String              @db.Text
  content_version    String              @db.VarChar(64)
  task_title         String              @db.Text
  task_part          Int
  reference_snapshot Json
  submitted_at       DateTime            @default(now()) @db.Timestamp(6)
  users              users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_submissions_user_id_fkey")
  task               toeic_writing_tasks @relation(fields: [task_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "toeic_writing_submissions_task_id_fkey")

  @@unique([user_id, submission_key], map: "toeic_writing_submissions_user_key")
  @@index([user_id, submitted_at], map: "toeic_writing_submissions_user_submitted_idx")
  @@index([user_id, task_id], map: "toeic_writing_submissions_user_task_idx")
}

model toeic_writing_image_contexts {
  id             Int                 @id @default(autoincrement())
  task_id        Int
  image_sha256   String              @db.VarChar(64)
  prompt_version String              @db.VarChar(64)
  model          String              @db.VarChar(100)
  context        Json
  created_at     DateTime            @default(now()) @db.Timestamp(6)
  updated_at     DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  task           toeic_writing_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_image_contexts_task_id_fkey")

  @@unique([task_id, image_sha256, prompt_version], map: "toeic_writing_image_contexts_identity_key")
}

model toeic_writing_ai_grades {
  id              Int                 @id @default(autoincrement())
  user_id         String
  task_id         Int
  content_version String              @db.VarChar(64)
  response_hash   String              @db.VarChar(64)
  prompt_version  String              @db.VarChar(64)
  part            Int
  locale          String              @db.VarChar(5)
  model           String              @db.VarChar(100)
  rubric_version  String              @db.VarChar(64)
  assistance      Json
  result          Json
  context_source  String?             @db.VarChar(20)
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  users           users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_ai_grades_user_id_fkey")
  task            toeic_writing_tasks @relation(fields: [task_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "toeic_writing_ai_grades_task_id_fkey")

  @@unique([user_id, task_id, content_version, response_hash, prompt_version], map: "toeic_writing_ai_grades_cache_key")
  @@index([user_id, created_at], map: "toeic_writing_ai_grades_user_created_idx")
  @@index([user_id, task_id, created_at], map: "toeic_writing_ai_grades_user_task_idx")
}

model toeic_writing_assistance_events {
  id              Int                 @id @default(autoincrement())
  user_id         String
  task_id         Int
  content_version String              @db.VarChar(64)
  kind            String              @db.VarChar(32)
  created_at      DateTime            @default(now()) @db.Timestamp(6)
  users           users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_assistance_events_user_id_fkey")
  task            toeic_writing_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_writing_assistance_events_task_id_fkey")

  @@unique([user_id, task_id, content_version, kind], map: "toeic_writing_assistance_events_identity_key")
  @@index([user_id, created_at], map: "toeic_writing_assistance_events_user_created_idx")
}

model ai_usage_daily {
  id         Int      @id @default(autoincrement())
  user_id    String
  feature    String   @db.VarChar(40)
  usage_date DateTime @db.Date
  reserved   Int      @default(0)
  used       Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_usage_daily_user_id_fkey")

  @@unique([user_id, feature, usage_date], map: "ai_usage_daily_identity_key")
}

model ai_usage_reservations {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String
  feature         String    @db.VarChar(40)
  idempotency_key String    @db.Uuid
  response_hash   String    @db.VarChar(64)
  usage_date      DateTime  @db.Date
  status          String    @db.VarChar(20)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  expires_at      DateTime  @db.Timestamp(6)
  completed_at    DateTime? @db.Timestamp(6)
  released_at     DateTime? @db.Timestamp(6)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_usage_reservations_user_id_fkey")

  @@unique([user_id, idempotency_key], map: "ai_usage_reservations_user_key")
  @@index([user_id, feature, created_at], map: "ai_usage_reservations_user_feature_created_idx")
  @@index([status, expires_at], map: "ai_usage_reservations_status_expiry_idx")
}

