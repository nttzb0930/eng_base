generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Người dùng hệ thống (admin, staff)
model users {
  id                              String                            @id @default(uuid())
  /// Email đăng nhập, duy nhất trong hệ thống
  email                           String                            @unique
  /// Mật khẩu đã được hash (PBKDF2)
  password                        String
  /// Tên đăng nhập duy nhất
  username                        String                            @unique
  /// Họ và tên đầy đủ
  full_name                       String
  /// Vai trò: ADMIN, USER
  role                            user_role                         @default(USER)
  /// Thời điểm email được xác thực; null với tài khoản mới chưa xác thực
  email_verified_at               DateTime?
  /// Mã xác thực đã hash, chỉ tồn tại trong thời gian chờ xác thực
  verification_code_hash          String?
  verification_code_expires_at    DateTime?
  verification_attempts           Int                               @default(0)
  verification_sent_at            DateTime?
  password_reset_code_hash        String?
  password_reset_code_expires_at  DateTime?
  password_reset_attempts         Int                               @default(0)
  password_reset_sent_at          DateTime?
  /// JWT refresh token (lưu để invalidate khi logout)
  refresh_token                   String?
  created_at                      DateTime                          @default(now()) @db.Timestamp(6)
  updated_at                      DateTime                          @default(now()) @updatedAt @db.Timestamp(6)
  reading_attempts                reading_attempts[]
  toeic_reading_attempts          toeic_reading_attempts[]
  toeic_listening_attempts        toeic_listening_attempts[]
  toeic_listening_drafts          toeic_listening_drafts[]
  toeic_reading_drafts            toeic_reading_drafts[]
  toeic_reading_practice_sessions toeic_reading_practice_sessions[]
  grammar_question_attempts       grammar_question_attempts[]
  grammar_question_progress       grammar_question_progress[]
  toeic_dictation_progress        toeic_dictation_progress[]
  toeic_dictation_attempts        toeic_dictation_attempts[]
  toeic_writing_drafts            toeic_writing_drafts[]
  toeic_writing_submissions       toeic_writing_submissions[]
  toeic_writing_ai_grades         toeic_writing_ai_grades[]
  toeic_writing_assistance_events toeic_writing_assistance_events[]
  ai_usage_daily                  ai_usage_daily[]
  ai_usage_reservations           ai_usage_reservations[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model challenge_options {
  id           Int        @id @default(autoincrement())
  challenge_id Int
  text         String
  correct      Boolean
  image_src    String?
  audio_src    String?
  challenges   challenges @relation(fields: [challenge_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "challenge_options_challenge_id_challenges_id_fk")
}

model challenge_progress {
  id           Int        @id @default(autoincrement())
  user_id      String
  challenge_id Int
  completed    Boolean    @default(false)
  challenges   challenges @relation(fields: [challenge_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "challenge_progress_challenge_id_challenges_id_fk")

  @@unique([user_id, challenge_id], map: "challenge_progress_user_challenge_idx")
}

model challenges {
  id                 Int                  @id @default(autoincrement())
  lesson_id          Int
  type               type
  question           String
  order              Int
  vocabulary_item_id Int?
  direction          challenge_direction?
  challenge_options  challenge_options[]
  challenge_progress challenge_progress[]
  lessons            lessons              @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "challenges_lesson_id_lessons_id_fk")
  vocabulary_items   vocabulary_items?    @relation(fields: [vocabulary_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "challenges_vocabulary_item_id_vocabulary_items_id_fk")
}

model courses {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique
  title              String
  image_src          String
  units              units[]
  user_progress      user_progress[]
  toeic_test_sets    toeic_test_sets[]
  toeic_writing_sets toeic_writing_sets[]
}

model toeic_test_sets {
  id            Int           @id @default(autoincrement())
  course_id     Int
  source        String
  source_set_id String
  title         String
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  courses       courses       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_test_sets_course_id_fkey")
  toeic_tests   toeic_tests[]

  @@unique([course_id, source, source_set_id], map: "toeic_test_sets_course_source_set_key")
}

model toeic_tests {
  id                              Int                               @id @default(autoincrement())
  test_set_id                     Int
  source                          String
  source_test_id                  String
  source_version                  String                            @db.VarChar(64)
  listening_source_version        String?                           @db.VarChar(64)
  title                           String
  status                          toeic_publication_status          @default(PUBLISHED)
  published_at                    DateTime?                         @db.Timestamp(6)
  listening_status                toeic_publication_status          @default(DRAFT)
  listening_published_at          DateTime?                         @db.Timestamp(6)
  created_at                      DateTime                          @default(now()) @db.Timestamp(6)
  updated_at                      DateTime                          @default(now()) @updatedAt @db.Timestamp(6)
  toeic_test_sets                 toeic_test_sets                   @relation(fields: [test_set_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_tests_test_set_id_fkey")
  toeic_stimuli                   toeic_stimuli[]
  toeic_questions                 toeic_questions[]
  toeic_media_assets              toeic_media_assets[]
  toeic_reading_attempts          toeic_reading_attempts[]
  toeic_listening_attempts        toeic_listening_attempts[]
  toeic_listening_drafts          toeic_listening_drafts[]
  toeic_reading_drafts            toeic_reading_drafts[]
  toeic_reading_practice_sessions toeic_reading_practice_sessions[]

  @@unique([source, source_test_id], map: "toeic_tests_source_test_id_key")
  @@index([status, published_at], map: "toeic_tests_status_published_idx")
  @@index([listening_status, listening_published_at], map: "toeic_tests_listening_status_published_idx")
}

model toeic_stimuli {
  id                     Int                    @id @default(autoincrement())
  test_id                Int
  source_stimulus_id     String
  part                   Int
  kind                   String
  body                   String?
  translation            String?
  transcript             String?
  transcript_translation String?
  toeic_tests            toeic_tests            @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_stimuli_test_id_fkey")
  toeic_questions        toeic_questions[]
  toeic_media_bindings   toeic_media_bindings[]

  @@unique([test_id, source_stimulus_id], map: "toeic_stimuli_test_source_id_key")
  @@index([test_id, part], map: "toeic_stimuli_test_part_idx")
}

model toeic_questions {
  id                              Int                              @id @default(autoincrement())
  test_id                         Int
  stimulus_id                     Int?
  source_question_id              String
  number                          Int
  part                            Int
  prompt                          String
  translation                     String?
  explanation                     String?
  transcript                      String?
  transcript_translation          String?
  difficulty_level                Int?
  error_rate                      Float?
  total_attempts                  Int?
  toeic_tests                     toeic_tests                      @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_questions_test_id_fkey")
  toeic_stimuli                   toeic_stimuli?                   @relation(fields: [stimulus_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "toeic_questions_stimulus_id_fkey")
  toeic_question_options          toeic_question_options[]
  toeic_media_bindings            toeic_media_bindings[]
  toeic_question_vocabulary_cache toeic_question_vocabulary_cache?

  @@unique([test_id, source_question_id], map: "toeic_questions_test_source_id_key")
  @@unique([test_id, number], map: "toeic_questions_test_number_key")
  @@index([test_id, part], map: "toeic_questions_test_part_idx")
  @@index([stimulus_id], map: "toeic_questions_stimulus_idx")
}

model toeic_question_vocabulary_cache {
  question_id             Int             @id
  vocabulary              Json
  source_inventory_sha256 String          @db.VarChar(64)
  created_at              DateTime        @default(now()) @db.Timestamp(6)
  updated_at              DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  toeic_questions         toeic_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_question_vocabulary_cache_question_id_fkey")

  @@index([source_inventory_sha256], map: "toeic_question_vocabulary_cache_inventory_idx")
}

model toeic_question_options {
  id              Int             @id @default(autoincrement())
  question_id     Int
  label           String          @db.VarChar(1)
  text            String
  correct         Boolean         @default(false)
  toeic_questions toeic_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_question_options_question_id_fkey")

  @@unique([question_id, label], map: "toeic_question_options_question_label_key")
}

model toeic_media_assets {
  id                   Int                    @id @default(autoincrement())
  test_id              Int
  source_media_id      String
  source_url           String
  storage_path         String?
  sha256               String?                @db.VarChar(64)
  bytes                Int?
  content_type         String?
  status               String
  toeic_tests          toeic_tests            @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_media_assets_test_id_fkey")
  toeic_media_bindings toeic_media_bindings[]

  @@unique([test_id, source_media_id], map: "toeic_media_assets_test_source_id_key")
}

model toeic_media_bindings {
  id                 Int                @id @default(autoincrement())
  media_asset_id     Int
  question_id        Int?
  stimulus_id        Int?
  role               String
  order              Int                @default(0)
  toeic_media_assets toeic_media_assets @relation(fields: [media_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_media_bindings_media_asset_id_fkey")
  toeic_questions    toeic_questions?   @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_media_bindings_question_id_fkey")
  toeic_stimuli      toeic_stimuli?     @relation(fields: [stimulus_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_media_bindings_stimulus_id_fkey")

  @@unique([question_id, media_asset_id, role], map: "toeic_media_bindings_question_asset_role_key")
  @@unique([stimulus_id, media_asset_id, role], map: "toeic_media_bindings_stimulus_asset_role_key")
  @@index([question_id, order], map: "toeic_media_bindings_question_idx")
  @@index([stimulus_id, order], map: "toeic_media_bindings_stimulus_idx")
  @@index([media_asset_id], map: "toeic_media_bindings_asset_idx")
}

model toeic_reading_attempts {
  id                            Int                             @id @default(autoincrement())
  user_id                       String
  test_id                       Int
  practice_part                 Int?
  submission_key                String                          @db.Uuid
  submission_fingerprint        String
  source_version_snapshot       String                          @db.VarChar(64)
  test_title_snapshot           String
  correct_count                 Int
  total_count                   Int
  accuracy                      Int
  submitted_at                  DateTime                        @default(now()) @db.Timestamp(6)
  users                         users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_reading_attempts_user_id_fkey")
  toeic_tests                   toeic_tests                     @relation(fields: [test_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "toeic_reading_attempts_test_id_fkey")
  toeic_reading_attempt_answers toeic_reading_attempt_answers[]

  @@unique([user_id, submission_key], map: "toeic_reading_attempts_user_submission_key_key")
  @@index([user_id, submitted_at], map: "toeic_reading_attempts_user_submitted_idx")
  @@index([user_id, practice_part, submitted_at], map: "toeic_reading_attempts_user_practice_part_submitted_idx")
  @@index([test_id], map: "toeic_reading_attempts_test_idx")
}

model toeic_reading_attempt_answers {
  id                             Int                    @id @default(autoincrement())
  attempt_id                     Int
  question_id_snapshot           Int
  question_number_snapshot       Int
  part_snapshot                  Int
  selected_option_id_snapshot    Int
  question_prompt_snapshot       String
  selected_option_label_snapshot String                 @db.VarChar(1)
  selected_option_text_snapshot  String
  correct_option_label_snapshot  String                 @db.VarChar(1)
  correct_option_text_snapshot   String
  explanation_snapshot           String?
  correct                        Boolean
  toeic_reading_attempts         toeic_reading_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_reading_attempt_answers_attempt_id_fkey")

  @@unique([attempt_id, question_id_snapshot], map: "toeic_reading_attempt_answers_attempt_question_key")
  @@index([attempt_id, part_snapshot], map: "toeic_reading_attempt_answers_attempt_part_idx")
}

model toeic_listening_attempts {
  id                                Int                               @id @default(autoincrement())
  user_id                           String
  test_id                           Int
  practice_part                     Int?
  submission_key                    String                            @db.Uuid
  submission_fingerprint            String
  listening_source_version_snapshot String                            @db.VarChar(64)
  test_title_snapshot               String
  correct_count                     Int
  total_count                       Int
  accuracy                          Int
  submitted_at                      DateTime                          @default(now()) @db.Timestamp(6)
  users                             users                             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_listening_attempts_user_id_fkey")
  toeic_tests                       toeic_tests                       @relation(fields: [test_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "toeic_listening_attempts_test_id_fkey")
  toeic_listening_attempt_answers   toeic_listening_attempt_answers[]

  @@unique([user_id, submission_key], map: "toeic_listening_attempts_user_submission_key_key")
  @@index([user_id, submitted_at], map: "toeic_listening_attempts_user_submitted_idx")
  @@index([user_id, practice_part, submitted_at], map: "toeic_listening_attempts_user_practice_part_submitted_idx")
  @@index([test_id], map: "toeic_listening_attempts_test_idx")
}

model toeic_listening_attempt_answers {
  id                              Int                      @id @default(autoincrement())
  attempt_id                      Int
  question_id_snapshot            Int
  question_number_snapshot        Int
  part_snapshot                   Int
  selected_option_id_snapshot     Int
  question_prompt_snapshot        String
  transcript_snapshot             String?
  transcript_translation_snapshot String?
  question_media_snapshot         Json
  stimulus_snapshot               Json?
  selected_option_label_snapshot  String                   @db.VarChar(1)
  selected_option_text_snapshot   String
  correct_option_label_snapshot   String                   @db.VarChar(1)
  correct_option_text_snapshot    String
  explanation_snapshot            String?
  correct                         Boolean
  toeic_listening_attempts        toeic_listening_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_listening_attempt_answers_attempt_id_fkey")

  @@unique([attempt_id, question_id_snapshot], map: "toeic_listening_attempt_answers_attempt_question_key")
  @@index([attempt_id, part_snapshot], map: "toeic_listening_attempt_answers_attempt_part_idx")
}

model toeic_listening_drafts {
  id                       Int         @id @default(autoincrement())
  user_id                  String
  test_id                  Int
  scope                    String      @db.VarChar(6)
  listening_source_version String      @db.VarChar(64)
  active_question_id       Int
  answers                  Json
  review_question_ids      Int[]
  completed_media_ids      Int[]
  active_media_id          Int?
  playback_position_ms     Int
  created_at               DateTime    @default(now()) @db.Timestamp(6)
  updated_at               DateTime    @default(now()) @updatedAt @db.Timestamp(6)
  expires_at               DateTime    @db.Timestamp(6)
  users                    users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_listening_drafts_user_id_fkey")
  toeic_tests              toeic_tests @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_listening_drafts_test_id_fkey")

  @@unique([user_id, test_id, scope], map: "toeic_listening_drafts_user_test_scope_key")
  @@index([user_id, updated_at], map: "toeic_listening_drafts_user_updated_idx")
  @@index([expires_at], map: "toeic_listening_drafts_expires_idx")
  @@index([test_id], map: "toeic_listening_drafts_test_idx")
}

model toeic_reading_drafts {
  id                  Int         @id @default(autoincrement())
  user_id             String
  test_id             Int
  scope               String      @db.VarChar(6)
  source_version      String      @db.VarChar(64)
  active_question_id  Int
  answers             Json
  review_question_ids Int[]
  created_at          DateTime    @default(now()) @db.Timestamp(6)
  updated_at          DateTime    @default(now()) @updatedAt @db.Timestamp(6)
  expires_at          DateTime    @db.Timestamp(6)
  users               users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_reading_drafts_user_id_fkey")
  toeic_tests         toeic_tests @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_reading_drafts_test_id_fkey")

  @@unique([user_id, test_id, scope], map: "toeic_reading_drafts_user_test_scope_key")
  @@index([user_id, updated_at], map: "toeic_reading_drafts_user_updated_idx")
  @@index([expires_at], map: "toeic_reading_drafts_expires_idx")
  @@index([test_id], map: "toeic_reading_drafts_test_idx")
}

model toeic_reading_practice_sessions {
  id                             Int                              @id @default(autoincrement())
  user_id                        String
  test_id                        Int
  part                           Int
  source_version                 String                           @db.VarChar(64)
  status                         String                           @db.VarChar(12)
  active_key                     String?                          @unique(map: "toeic_reading_practice_sessions_active_key_key")
  active_question_id             Int
  review_question_ids            Int[]
  correct_count                  Int                              @default(0)
  incorrect_count                Int                              @default(0)
  created_at                     DateTime                         @default(now()) @db.Timestamp(6)
  updated_at                     DateTime                         @default(now()) @updatedAt @db.Timestamp(6)
  completed_at                   DateTime?                        @db.Timestamp(6)
  users                          users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_reading_practice_sessions_user_id_fkey")
  toeic_tests                    toeic_tests                      @relation(fields: [test_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "toeic_reading_practice_sessions_test_id_fkey")
  toeic_reading_practice_answers toeic_reading_practice_answers[]

  @@index([user_id, updated_at], map: "toeic_reading_practice_sessions_user_updated_idx")
  @@index([test_id, part], map: "toeic_reading_practice_sessions_test_part_idx")
}

model toeic_reading_practice_answers {
  id                              Int                             @id @default(autoincrement())
  session_id                      Int
  request_key                     String                          @db.Uuid
  question_id_snapshot            Int
  question_number_snapshot        Int
  selected_option_id_snapshot     Int
  selected_option_label_snapshot  String                          @db.VarChar(1)
  selected_option_text_snapshot   String
  correct_option_id_snapshot      Int
  correct_option_label_snapshot   String                          @db.VarChar(1)
  correct_option_text_snapshot    String
  explanation_snapshot            String?
  question_translation_snapshot   String?
  correct                         Boolean
  answered_at                     DateTime                        @default(now()) @db.Timestamp(6)
  toeic_reading_practice_sessions toeic_reading_practice_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_reading_practice_answers_session_id_fkey")

  @@unique([session_id, question_id_snapshot], map: "toeic_reading_practice_answers_session_question_key")
  @@unique([session_id, request_key], map: "toeic_reading_practice_answers_session_request_key_key")
  @@index([session_id, answered_at], map: "toeic_reading_practice_answers_session_answered_idx")
}

model toeic_dictation_sets {
  id                    Int                                @id @default(autoincrement())
  source                String
  source_set_id         String
  source_version        String                             @db.VarChar(64)
  collection_name       String
  display_name          String
  test_number           Int
  part                  Int
  status                toeic_dictation_publication_status @default(DRAFT)
  published_at          DateTime?                          @db.Timestamp(6)
  item_count            Int                                @default(0)
  created_at            DateTime                           @default(now()) @db.Timestamp(6)
  updated_at            DateTime                           @default(now()) @updatedAt @db.Timestamp(6)
  toeic_dictation_items toeic_dictation_items[]

  @@unique([source, source_set_id], map: "toeic_dictation_sets_source_set_key")
  @@index([collection_name, test_number, part, status], map: "toeic_dictation_sets_catalog_idx")
}

model toeic_dictation_items {
  id                       Int                        @id @default(autoincrement())
  set_id                   Int
  source_item_id           String
  source_version           String                     @db.VarChar(64)
  order_index              Int
  source_group             String?
  transcript               String
  translation_vi           String?
  audio_asset_id           String
  audio_storage_path       String
  audio_sha256             String                     @db.VarChar(64)
  audio_bytes              Int
  audio_content_type       String
  audio_duration_ms        Int?
  validation_status        String                     @default("VALID")
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now()) @db.Timestamp(6)
  updated_at               DateTime                   @default(now()) @updatedAt @db.Timestamp(6)
  toeic_dictation_sets     toeic_dictation_sets       @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_dictation_items_set_id_fkey")
  toeic_dictation_progress toeic_dictation_progress[]
  toeic_dictation_attempts toeic_dictation_attempts[]

  @@unique([set_id, source_item_id], map: "toeic_dictation_items_set_source_item_key")
  @@unique([set_id, order_index], map: "toeic_dictation_items_set_order_key")
  @@index([set_id, is_active, order_index], map: "toeic_dictation_items_set_active_order_idx")
}

model toeic_dictation_progress {
  id                    Int                   @id @default(autoincrement())
  user_id               String
  item_id               Int
  latest_accuracy       Int                   @default(0)
  words_correct         Int                   @default(0)
  total_words           Int                   @default(0)
  attempts_count        Int                   @default(0)
  mastered              Boolean               @default(false)
  last_typed_text       String?
  last_attempted_at     DateTime?             @db.Timestamp(6)
  completed_at          DateTime?             @db.Timestamp(6)
  created_at            DateTime              @default(now()) @db.Timestamp(6)
  updated_at            DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  users                 users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "toeic_dictation_progress_user_id_fkey")
