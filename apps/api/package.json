{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start:dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "build": "nest build",
    "architecture:check": "tsx --test test/api-source-architecture.test.ts test/auth-source-architecture.test.ts test/domain-ownership-architecture.test.ts && eslint src/module/user src/module/practice src/module/settings src/module/courses --max-warnings=0",
    "test": "tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "lint": "eslint src scripts --max-warnings=0",
    "check-types": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx ./scripts/seed.ts",
    "data:build-vocab": "dotenv -e ../../.env -- tsx ./scripts/build-vocab-dataset.ts",
    "data:enrich-audio": "dotenv -e ../../.env -- tsx ./scripts/enrich-vocab-audio.ts",
    "data:enrich-examples": "dotenv -e ../../.env -- tsx ./scripts/enrich-vocab-examples.ts",
    "data:enrich-json": "dotenv -e ../../.env -- tsx ./scripts/enrich-json.ts",
    "data:export-vocab": "dotenv -e ../../.env -- tsx ./scripts/export-vocab.ts",
    "data:export-vocab-snapshot": "dotenv -e ../../.env -- tsx ./scripts/export-vocab-db-snapshot.ts",
    "data:export-vocab-risk": "dotenv -e ../../.env -- tsx ./scripts/export-vocab-risk-audit.ts",
    "data:prepare-vocab-normalization": "dotenv -e ../../.env -- tsx ./scripts/prepare-vocab-normalization.ts",
    "data:normalize-vocab-gemini": "dotenv -e ../../.env -- tsx ./scripts/run-vocab-normalization-gemini.ts",
    "data:apply-vocab-normalization-override": "dotenv -e ../../.env -- tsx ./scripts/apply-vocab-normalization-override.ts",
    "data:apply-vocab-review-overrides": "dotenv -e ../../.env -- tsx ./scripts/apply-vocab-review-overrides.ts",
    "data:merge-vocab-normalization": "dotenv -e ../../.env -- tsx ./scripts/merge-vocab-normalization.ts",
    "data:sync-vocab-normalization": "dotenv -e ../../.env -- tsx ./scripts/sync-vocab-normalization-to-db.ts",
    "data:prepare-vocab-pos-correction": "dotenv -e ../../.env -- tsx ./scripts/prepare-vocab-pos-correction.ts",
    "data:correct-vocab-pos-gemini": "dotenv -e ../../.env -- tsx ./scripts/run-vocab-pos-correction-gemini.ts",
    "data:merge-vocab-pos-correction": "dotenv -e ../../.env -- tsx ./scripts/merge-vocab-pos-correction.ts",
    "data:sync-vocab-pos-correction": "dotenv -e ../../.env -- tsx ./scripts/sync-vocab-pos-correction-to-db.ts",
    "data:seed-topics": "dotenv -e ../../.env -- tsx ./scripts/seed-vocab-topics.ts"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "typescript-eslint": "^8.57.0"
  }
}
