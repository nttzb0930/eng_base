    "data:enrich-topic-candidates-queue": "dotenv -e ../../.env -- tsx ./scripts/vocabulary/topic-expansion/enrich-topic-candidates-queue.ts",
    "data:audit-topic-expansion": "dotenv -e ../../.env -- tsx ./scripts/vocabulary/topic-expansion/audit-topic-expansion.ts",
