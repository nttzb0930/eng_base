# .env

# disabled next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# clerk auth keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# clerk redirect urls
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# postgres database uri
# local docker example: postgresql://postgres:123456@localhost:5432/lingo
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/lingo"

# public app url
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API authentication and abuse protection
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_IDENTITY_LIMIT=5
AUTH_LOGIN_TTL=60
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_TTL=3600
AUTH_REFRESH_IP_LIMIT=30
AUTH_REFRESH_SESSION_LIMIT=10
AUTH_REFRESH_TTL=60
# Keep 0 for direct/local traffic; set to the known proxy hop count in deployment.
TRUST_PROXY_HOPS=0

# clerk admin user id(s) separated by comma and space (, )
CLERK_ADMIN_IDS="user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# or CLERK_ADMIN_IDS="user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx, user_xxxxxxxxxxxxxxxxxxxxxx" for multiple admins.
# Gemini API key used only by the offline vocabulary normalization runner.
GEMINI_API_KEY=
GEMINI_BATCH_POLL_INTERVAL_MS=30000
