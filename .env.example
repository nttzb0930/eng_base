# Root .env template.
# All API scripts read this file from the workspace root with:
# dotenv -e ../../.env

# Runtime
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Database
# local docker example: postgresql://postgres:123456@localhost:5432/lingo
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/lingo"

# Web/Admin/API URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API authentication
# Use two different secrets, each at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Global API rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Auth endpoint rate limiting
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_IDENTITY_LIMIT=5
AUTH_LOGIN_TTL=60
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_TTL=3600
AUTH_REFRESH_IP_LIMIT=30
AUTH_REFRESH_SESSION_LIMIT=10
AUTH_REFRESH_TTL=60

# Proxy/IP handling
# Keep 0 for direct/local traffic; set to the known proxy hop count in deployment.
TRUST_PROXY_HOPS=0

# Offline vocabulary tooling.
# These are not required to boot the API.
GEMINI_API_KEY=
GEMINI_BATCH_POLL_INTERVAL_MS=30000
VOCAB_AI_PROVIDER=gemini
VOCAB_NORMALIZATION_PROFILE=full
GEMINI_VOCAB_NORMALIZATION_MODEL=
GEMINI_VOCAB_POS_CORRECTION_MODEL=
GEMINI_VOCAB_POS_CORRECTION_MODELS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_JSON_MODE=true
CEFR_WORDLIST_PATH=
VI_DICTIONARY_PATH=
