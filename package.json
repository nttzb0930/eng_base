{
  "name": "eng_base",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo run dev --filter=@repo/web...",
    "dev:admin": "turbo run dev --filter=@repo/admin...",
    "dev:api": "turbo run dev --filter=@repo/api...",
    "build": "turbo build",
    "architecture:check": "turbo run architecture:check",
    "test": "turbo test",
    "test:api": "pnpm --filter @repo/api test",
    "test:web": "pnpm --filter @repo/web test",
    "test:admin": "pnpm --filter @repo/admin test",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:push": "pnpm --filter @repo/api db:push",
    "db:studio": "pnpm --filter @repo/api db:studio",
    "db:seed:dev": "pnpm --filter @repo/api db:seed:dev"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tsx": "4.23.0",
    "turbo": "^2.8.10"
  }
}
