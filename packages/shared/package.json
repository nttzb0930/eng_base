{
  "name": "@repo/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./courses": {
      "types": "./dist/courses/index.d.ts",
      "default": "./dist/courses/index.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary/index.d.ts",
      "default": "./dist/vocabulary/index.js"
    },
    "./practice": {
      "types": "./dist/practice/index.d.ts",
      "default": "./dist/practice/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "default": "./dist/review/index.js"
    },
    "./placement-test": {
      "types": "./dist/placement-test/index.d.ts",
      "default": "./dist/placement-test/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    },
    "./flashcards": {
      "types": "./dist/flashcards/index.d.ts",
      "default": "./dist/flashcards/index.js"
    },
    "./progress": {
      "types": "./dist/progress/index.d.ts",
      "default": "./dist/progress/index.js"
    },
    "./learning": {
      "types": "./dist/learning/index.d.ts",
      "default": "./dist/learning/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "architecture:check": "tsx --test \"test/courses/**/*.test.ts\"",
    "check-types": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "pretest": "pnpm run build",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "tsx": "^4.22.4",
    "typescript": "^6"
  }
}
